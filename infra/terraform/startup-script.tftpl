#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
required_packages=(ca-certificates curl gpg unattended-upgrades)
missing_packages=()
for package in "$${required_packages[@]}"; do
  if ! dpkg-query -W -f='$${Status}' "$${package}" 2>/dev/null | grep -q 'install ok installed'; then
    missing_packages+=("$${package}")
  fi
done
if [ "$${#missing_packages[@]}" -gt 0 ]; then
  apt-get update -qq
  apt-get install -y -qq "$${missing_packages[@]}"
fi
if ! command -v gcloud >/dev/null; then
  curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
  echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" > /etc/apt/sources.list.d/google-cloud-sdk.list
  apt-get update -qq && apt-get install -y -qq google-cloud-cli
fi
if ! command -v docker >/dev/null; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu noble stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi
systemctl enable --now docker
gcloud auth configure-docker ${container_registry} --quiet
mkdir -p /secrets /opt/slack-scheduler
%{ for var_name, secret_id in secret_names ~}
mkdir -p "/secrets/${var_name}"
gcloud secrets versions access latest --secret="${secret_id}" --format='get(payload.data)' | base64 -d > "/secrets/${var_name}/${var_name}"
chmod 400 "/secrets/${var_name}/${var_name}"
chown 1000:1000 "/secrets/${var_name}/${var_name}"
%{ endfor ~}
cat > /opt/slack-scheduler/docker-compose.yml <<'COMPOSE_EOF'
services:
  app:
    image: ${container_image}
    container_name: slack-scheduler
    restart: unless-stopped
    ports: ["127.0.0.1:3000:3000"]
    volumes: ["/secrets:/secrets:ro"]
    environment:
      NODE_ENV: production
      PORT: "3000"
      PUBLIC_BASE_URL: ${public_base_url}
      DATABASE_BACKEND: postgres
      DATABASE_SSL_MODE: disable
      DATABASE_URL_FILE: /secrets/DATABASE_URL/DATABASE_URL
      GOOGLE_KMS_KEY_NAME: ${kms_key_name}
      SLACK_BOT_TOKEN_FILE: /secrets/SLACK_BOT_TOKEN/SLACK_BOT_TOKEN
      SLACK_APP_TOKEN_FILE: /secrets/SLACK_APP_TOKEN/SLACK_APP_TOKEN
      JAZZHR_API_KEY_FILE: /secrets/JAZZHR_API_KEY/JAZZHR_API_KEY
      GOOGLE_CLIENT_SECRET_FILE: /secrets/GOOGLE_CLIENT_SECRET/GOOGLE_CLIENT_SECRET
      RECRUITER_PHONE_EXPORT_TOKEN_FILE: /secrets/RECRUITER_PHONE_EXPORT_TOKEN/RECRUITER_PHONE_EXPORT_TOKEN
      ROLE_ASSIGNMENT_EXPORT_TOKEN_FILE: /secrets/ROLE_ASSIGNMENT_EXPORT_TOKEN/ROLE_ASSIGNMENT_EXPORT_TOKEN
%{ for var_name, secret_id in runtime_config_secret_names ~}
      ${var_name}_FILE: /secrets/${var_name}/${var_name}
%{ endfor ~}
      SLACK_TEAM_ID: ${slack_team_id}
      SLACK_POSTING_CHANNEL_ID: ${slack_posting_channel_id}
      SLACK_RECRUITMENT_USER_IDS: ${slack_recruitment_user_ids}
      SLACK_ADMIN_USER_IDS: ${slack_admin_user_ids}
      SLACK_ALERT_USER_IDS: ${slack_alert_user_ids}
      ACCESS_CONTROL_ENFORCED: "true"
      GOOGLE_CLIENT_ID: ${google_client_id}
      GOOGLE_REDIRECT_URI: ${google_redirect_uri}
      GOOGLE_SHARED_CALENDAR_ID: ${google_shared_calendar_id}
      GOOGLE_AUTH_SLACK_USER_ID: ${google_auth_slack_user_id}
  caddy:
    image: caddy:2-alpine
    restart: unless-stopped
    depends_on: [app]
    ports: ["80:80", "443:443"]
    volumes: ["/opt/slack-scheduler/Caddyfile:/etc/caddy/Caddyfile:ro", "caddy_data:/data", "caddy_config:/config"]
volumes: { caddy_data: {}, caddy_config: {} }
COMPOSE_EOF
cat > /opt/slack-scheduler/Caddyfile <<'CADDY_EOF'
${public_base_url_domain} { reverse_proxy app:3000 }
CADDY_EOF
until timeout 2 bash -c '</dev/tcp/${db_ip}/5432' >/dev/null 2>&1; do
  sleep 5
done
cd /opt/slack-scheduler
docker compose pull app
docker compose up -d --remove-orphans
docker compose ps
