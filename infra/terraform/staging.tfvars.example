project_id       = "replace-with-staging-project"
environment      = "staging"
region           = "us-central1"
container_image  = "us-central1-docker.pkg.dev/replace-with-staging-project/slack-scheduler-image/app:bootstrap"
github_repository = "regulus-j/slack-schedule"

public_base_url             = "https://replace-with-staging-cloud-run-url"
slack_team_id               = "T_REPLACE"
slack_recruitment_user_ids  = "U_REPLACE"
slack_admin_user_ids        = "U_REPLACE"
slack_alert_user_ids        = "U_REPLACE"
google_redirect_uri         = "https://replace-with-staging-cloud-run-url/oauth/google/callback"
google_auth_slack_user_id   = "U_REPLACE_SHARED_OAUTH_OWNER"
google_account_by_jazzhr_account = "{\"default\":\"shared-calendar@example.com\"}"
monitoring_email            = "security-team@example.com"
secret_next_rotation_time   = "2026-09-21T00:00:00Z"
